# Production assets are served to end users through Nohm. Keep source maps out
# of the public build; private monitoring can upload maps from a separate CI
# build if that becomes part of the deployment pipeline.
GENERATE_SOURCEMAP=false

# Nohm serves Atlas data through this same-origin route. Keep the production
# default in source control so a direct `npm run build` cannot silently emit a
# bundle that calls Nohm's unrelated root `/api` namespace.
REACT_APP_API_URL=/atlas-api
